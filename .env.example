# https://my.telegram.org — user account, used only to read dialog metadata
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# @BotFather — sends the report back to you. It never reads your chats.
TELEGRAM_BOT_TOKEN=

# Optional. Leave empty and run /start on the bot; the chat id is stored in state.json.
TELEGRAM_REPORT_CHAT_ID=
